{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "seats": {
      "$room": {
        "$seat": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
